func _on_end_portal_open() -> void:
	texture=preload(\"res://images/AND gate - opening.png\")
	await get_tree().create_timer(0.5).timeout
	texture=preload(\"res://images/AND gate - still opening.png\")
	await get_tree().create_timer(0.5).timeout
	texture=preload(\"res://images/AND gate - ready.png\")
"

